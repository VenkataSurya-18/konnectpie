
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  PROVIDER
  ADMIN
}

enum TaskStatus {
  DRAFT
  PENDING_PAYMENT
  PUBLISHED
  ASSIGNED
  SUBMITTED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(WORKER)
  emailVerified Boolean        @default(false)
  banned        Boolean        @default(false)
  createdAt     DateTime       @default(now())

  tasksCreated  Task[]         @relation("Provider")
  tasksAssigned Task[]         @relation("Worker")
  claims        TaskClaim[]
  submissions   Submission[]
  notifications Notification[]
}

model Task {
  id          String         @id @default(uuid())
  title       String
  description String
  instructions String?
  status      TaskStatus     @default(DRAFT)
  providerId  String
  workerId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  provider    User           @relation("Provider", fields: [providerId], references: [id])
  worker      User?          @relation("Worker", fields: [workerId], references: [id])
  claims      TaskClaim[]
  submissions Submission[]
}

model TaskClaim {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model Submission {
  id          String           @id @default(uuid())
  taskId      String
  userId      String
  content     String
  status      SubmissionStatus @default(PENDING)
  reviewNotes String?
  createdAt   DateTime         @default(now())

  task        Task             @relation(fields: [taskId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}


model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
}

